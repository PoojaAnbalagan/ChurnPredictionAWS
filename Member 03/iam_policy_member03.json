{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucketWithPrefixFilter",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::churnpredictionaws-team-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "processed/*",
            "models/*",
            "output/predictions/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowReadProcessedCleanData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::churnpredictionaws-team-2026/processed/*"
    },
    {
      "Sid": "AllowReadAndWriteModels",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::churnpredictionaws-team-2026/models/*"
    },
    {
      "Sid": "AllowWritePredictionsOutput",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::churnpredictionaws-team-2026/output/predictions/*"
    },
    {
      "Sid": "AllowCloudWatchLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
